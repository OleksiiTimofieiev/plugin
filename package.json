{
  "name": "copilot-account-switcher",
  "displayName": "Copilot Account Switcher",
  "description": "Quickly switch the GitHub account used by GitHub Copilot",
  "version": "0.0.1",
  "publisher": "otimofie",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0b1220",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copilotAccountSwitcher.switchAccount",
        "title": "Switch Account",
        "category": "Copilot Account",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "copilotAccountSwitcher.addAccount",
        "title": "Add GitHub Account",
        "category": "Copilot Account",
        "icon": "$(add)"
      },
      {
        "command": "copilotAccountSwitcher.listAccounts",
        "title": "List GitHub Accounts",
        "category": "Copilot Account",
        "icon": "$(github)"
      },
      {
        "command": "copilotAccountSwitcher.refresh",
        "title": "Refresh",
        "category": "Copilot Account",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copilotAccountSwitcher",
          "title": "Copilot Accounts",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "copilotAccountSwitcher": [
        {
          "id": "copilotAccountSwitcher.accounts",
          "name": "GitHub Accounts",
          "icon": "media/activity-icon.svg",
          "contextualTitle": "Copilot Accounts"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "copilotAccountSwitcher.accounts",
        "contents": "No GitHub accounts are signed in.\n[Add GitHub Account](command:copilotAccountSwitcher.addAccount)",
        "when": "copilotAccountSwitcher.accountCount == 0"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "copilotAccountSwitcher.switchAccount",
          "when": "view == copilotAccountSwitcher.accounts",
          "group": "navigation@1"
        },
        {
          "command": "copilotAccountSwitcher.addAccount",
          "when": "view == copilotAccountSwitcher.accounts",
          "group": "navigation@2"
        },
        {
          "command": "copilotAccountSwitcher.refresh",
          "when": "view == copilotAccountSwitcher.accounts",
          "group": "navigation@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "copilotAccountSwitcher.switchAccount",
        "key": "ctrl+alt+shift+a",
        "mac": "cmd+alt+shift+a"
      }
    ],
    "configuration": {
      "title": "Copilot Account Switcher",
      "properties": {
        "copilotAccountSwitcher.targetExtension": {
          "type": "string",
          "default": "GitHub.copilot-chat",
          "enum": [
            "GitHub.copilot-chat",
            "GitHub.copilot"
          ],
          "description": "Which Copilot extension's GitHub account preference to switch."
        },
        "copilotAccountSwitcher.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show a status bar item that opens the account switcher."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
