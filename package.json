{
  "name": "vscode-account-switcher",
  "displayName": "Account Switcher",
  "description": "Switch the GitHub account used by GitHub Copilot with one click",
  "version": "0.0.1",
  "publisher": "otimofie",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0b1220",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "accountSwitcher.copilot.switch",
        "title": "Switch Copilot Account",
        "category": "Account Switcher",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "accountSwitcher.copilot.add",
        "title": "Add GitHub Account",
        "category": "Account Switcher",
        "icon": "$(add)"
      },
      {
        "command": "accountSwitcher.refresh",
        "title": "Refresh",
        "category": "Account Switcher",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "accountSwitcher",
          "title": "Account Switcher",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "accountSwitcher": [
        {
          "id": "accountSwitcher.copilot",
          "name": "GitHub Copilot",
          "icon": "media/activity-icon.svg",
          "contextualTitle": "Account Switcher"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "accountSwitcher.copilot",
        "contents": "No GitHub accounts are signed in.\n[Add GitHub Account](command:accountSwitcher.copilot.add)",
        "when": "accountSwitcher.copilotCount == 0"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "accountSwitcher.copilot.switch",
          "when": "view == accountSwitcher.copilot",
          "group": "navigation@1"
        },
        {
          "command": "accountSwitcher.copilot.add",
          "when": "view == accountSwitcher.copilot",
          "group": "navigation@2"
        },
        {
          "command": "accountSwitcher.refresh",
          "when": "view == accountSwitcher.copilot",
          "group": "navigation@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "accountSwitcher.copilot.switch",
        "key": "ctrl+alt+shift+a",
        "mac": "cmd+alt+shift+a"
      }
    ],
    "configuration": {
      "title": "Account Switcher",
      "properties": {
        "accountSwitcher.copilotExtension": {
          "type": "string",
          "default": "GitHub.copilot-chat",
          "enum": [
            "GitHub.copilot-chat",
            "GitHub.copilot"
          ],
          "description": "Which Copilot extension's GitHub account preference to switch."
        }
      }
    }
  },
  "repository": { "type": "git", "url": "https://github.com/OleksiiTimofieiev/plugin.git" },
  "bugs": { "url": "https://github.com/OleksiiTimofieiev/plugin/issues" },
  "homepage": "https://github.com/OleksiiTimofieiev/plugin#readme",
  "keywords": ["copilot", "github", "account", "switch"],
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
